# Porta do servidor (padrão 3000)
PORT=3000

# MySQL
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Assinatura dos tokens de sessão (mínimo de 32 caracteres, aleatório). Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Transmissão autônoma das NFC-e em contingência (GET /api/cron/contingencia; na Vercel a cada 15 min, pelo vercel.json).
# O agendador manda "Authorization: Bearer <CRON_SECRET>" (a Vercel Cron faz isso sozinha). Mínimo 16 caracteres.
CRON_SECRET=

# Teste 4 do PAF-NFC-e (nuvem): 1 = toda chamada à SEFAZ falha, para testar a contingência.
# Só vale em homologação (em produção é ignorada). Deixe vazio no uso normal.
NFE_SIMULAR_SEFAZ_FORA=
